#cloud-config

package_update: true
package_upgrade: false

packages:
  - wireguard
  - wireguard-tools
  - iptables
  - qrencode
  - curl
  - unbound
  - unbound-anchor
  - dnsdist
  - fail2ban
  - ufw
  - certbot
  - python3-certbot-dns-cloudflare

write_files:
  - path: /etc/sysctl.d/99-wireguard.conf
    owner: root:root
    permissions: '0644'
    content: |
      net.ipv4.ip_forward = 1
      net.ipv6.conf.all.forwarding = 1

  - path: /etc/sysctl.d/99-security-hardening.conf
    owner: root:root
    permissions: '0644'
    content: |
      # Prevent core dumps of setuid programs
      fs.suid_dumpable = 0

      # Protect FIFOs and regular files in world-writable sticky directories
      fs.protected_fifos = 2
      fs.protected_regular = 2

      # Core dumps include PID
      kernel.core_uses_pid = 1

      # Restrict SysRq
      kernel.sysrq = 0

      # Disable unprivileged eBPF
      kernel.unprivileged_bpf_disabled = 1

      # Ignore ICMP broadcast requests and bogus errors
      net.ipv4.icmp_echo_ignore_broadcasts = 1
      net.ipv4.icmp_ignore_bogus_error_responses = 1

      # Ignore ICMP redirects
      net.ipv4.conf.all.accept_redirects = 0
      net.ipv4.conf.default.accept_redirects = 0
      net.ipv6.conf.all.accept_redirects = 0
      net.ipv6.conf.default.accept_redirects = 0

      # Do not send ICMP redirects
      net.ipv4.conf.all.send_redirects = 0
      net.ipv4.conf.default.send_redirects = 0

      # Ignore source routed packets
      net.ipv4.conf.all.accept_source_route = 0
      net.ipv4.conf.default.accept_source_route = 0
      net.ipv6.conf.all.accept_source_route = 0
      net.ipv6.conf.default.accept_source_route = 0

      # Log Martian packets
      net.ipv4.conf.all.log_martians = 1
      net.ipv4.conf.default.log_martians = 1

      # Disable TCP timestamps to prevent remote uptime fingerprinting
      net.ipv4.tcp_timestamps = 0

  - path: /etc/systemd/journald.conf.d/paranoid.conf
    owner: root:root
    permissions: '0644'
    content: |
      [Journal]
      Storage=volatile
      RuntimeMaxUse=16M
      MaxRetentionSec=1day

  - path: /etc/ssh/sshd_config.d/99-hardening.conf
    owner: root:root
    permissions: '0644'
    content: |
      # SSH Hardening
      X11Forwarding no
      MaxAuthTries 3
      LogLevel VERBOSE
      AllowAgentForwarding no
      ClientAliveCountMax 2
      PermitRootLogin prohibit-password

  - path: /etc/systemd/resolved.conf.d/90-pi-hole-disable-stub-listener.conf
    owner: root:root
    permissions: '0644'
    content: |
      [Resolve]
      DNSStubListener=no

  - path: /etc/systemd/resolved.conf
    owner: root:root
    permissions: '0644'
    content: |
      [Resolve]
      DNS=127.0.0.1#${server_domain_name}
      DNSOverTLS=yes

  - path: /etc/unbound/unbound.conf.d/pi-hole.conf
    owner: root:root
    permissions: '0644'
    content: |
      server:
        module-config: "validator iterator"
        edns-tcp-keepalive: yes
        tcp-idle-timeout: 60000
        outgoing-num-tcp: 100
        incoming-num-tcp: 100
        verbosity: 0
        interface: 127.0.0.1
        port: 5335
        do-ip4: yes
        do-udp: yes
        do-tcp: yes
        do-ip6: no
        prefer-ip6: no
        root-hints: /var/lib/unbound/root.hints
        harden-glue: yes
        harden-dnssec-stripped: yes
        harden-algo-downgrade: yes
        harden-short-bufsize: yes
        harden-large-queries: yes
        val-clean-additional: yes
        use-caps-for-id: no
        edns-buffer-size: 1232
        prefetch: yes
        num-threads: 1
        qname-minimisation: yes
        hide-identity: yes
        hide-version: yes
        client-subnet-always-forward: no
        so-rcvbuf: 1m
        msg-cache-size: 64m
        rrset-cache-size: 128m
        cache-min-ttl: 300
        cache-max-ttl: 86400
        private-address: 192.168.0.0/16
        private-address: 169.254.0.0/16
        private-address: 172.16.0.0/12
        private-address: 10.0.0.0/8
        private-address: fd00::/8
        private-address: fe80::/10
        logfile: ""
        log-queries: no
        log-replies: no

  - path: /etc/dnsdist/dnsdist.conf
    owner: root:root
    permissions: '0640'
    content: |
      -- ========================================================
      -- Global Settings & Buffers
      -- ========================================================
      setRingBuffersSize(10000)
      setTCPRecvTimeout(30)
      setTCPSendTimeout(30)
      setMaxTCPConnectionsPerClient(100)
      setACL({"0.0.0.0/0", "::/0"})
      controlSocket("127.0.0.1:5199")
      setKey("Pga+xLRuvu2SrHR91GTPhQsvqQEXbrxFUyD0j+vzXWQ=")

      -- ========================================================
      -- Downstream Backends (Pi-hole)
      -- ========================================================
      newServer({
          address = "10.0.1.4:53",
          name = "pihole",
          tcpOnly = false,
          useClientSubnet = false,
          checkInterval = 2,
          maxCheckFailures = 3
      })

      -- ========================================================
      -- TLS / DoT Listeners (Port 853) - TLS 1.2 & TLS 1.3
      -- ========================================================
      addTLSLocal("10.0.1.4:853", "/etc/dnsdist/fullchain.pem", "/etc/dnsdist/privkey.pem", {
          provider = "openssl",
          minTLSVersion = "tls1.2"
      })
      addTLSLocal("10.8.0.1:853", "/etc/dnsdist/fullchain.pem", "/etc/dnsdist/privkey.pem", {
          provider = "openssl",
          minTLSVersion = "tls1.2"
      })
      addTLSLocal("127.0.0.1:853", "/etc/dnsdist/fullchain.pem", "/etc/dnsdist/privkey.pem", {
          provider = "openssl",
          minTLSVersion = "tls1.2"
      })

      -- ========================================================
      -- DoH Listeners (Port 443) - TLS 1.2 & TLS 1.3
      -- ========================================================
      addDOHLocal("10.0.1.4:443", "/etc/dnsdist/fullchain.pem", "/etc/dnsdist/privkey.pem", {"${doh_path}"}, {
          minTLSVersion = "tls1.2"
      })
      addDOHLocal("10.8.0.1:443", "/etc/dnsdist/fullchain.pem", "/etc/dnsdist/privkey.pem", {"${doh_path}", "/dns-query"}, {
          minTLSVersion = "tls1.2"
      })
      addDOHLocal("127.0.0.1:443", "/etc/dnsdist/fullchain.pem", "/etc/dnsdist/privkey.pem", {"${doh_path}", "/dns-query"}, {
          minTLSVersion = "tls1.2"
      })

      -- ========================================================
      -- DDoS Protection, Rate Limiting & Whitelist
      -- ========================================================
      local whitelist = newNMG()
      whitelist:addMask("127.0.0.1/32")
      whitelist:addMask("10.8.0.0/24")
      whitelist:addMask("10.0.1.0/24")

      addAction(
          AndRule({NotRule(NetmaskGroupRule(whitelist)), MaxQPSIPRule(100, 32, 64)}),
          DropAction()
      )

      local dbr = dynBlockRulesGroup()
      dbr:setQueryRate(300, 10, "Exceeded query rate limit", 60)
      dbr:excludeRange(whitelist)

      function maintenance()
          dbr:apply()
      end

  - path: /etc/fail2ban/jail.local
    owner: root:root
    permissions: '0644'
    content: |
      [DEFAULT]
      bantime = 1h
      findtime = 10m
      maxretry = 5
      banaction = ufw
      ignoreip = 127.0.0.1/8 ::1 10.8.0.0/24 10.0.1.0/24

      [sshd]
      enabled = true
      port = 22
      mode = aggressive
      backend = systemd

  - path: /etc/letsencrypt/renewal-hooks/deploy/dnsdist.sh
    owner: root:root
    permissions: '0755'
    content: |
      #!/bin/bash
      set -e

      cp -L /etc/letsencrypt/live/${server_domain_name}/fullchain.pem /etc/dnsdist/fullchain.pem
      cp -L /etc/letsencrypt/live/${server_domain_name}/privkey.pem /etc/dnsdist/privkey.pem

      chown _dnsdist:_dnsdist /etc/dnsdist/fullchain.pem /etc/dnsdist/privkey.pem
      chmod 600 /etc/dnsdist/privkey.pem
      chmod 644 /etc/dnsdist/fullchain.pem

      systemctl restart dnsdist

  - path: /etc/pihole/setupVars.conf
    owner: root:root
    permissions: '0644'
    content: |
      PIHOLE_INTERFACE=10.8.0.1
      IPV4_ADDRESS=10.8.0.1/24
      QUERY_LOGGING=false
      INSTALL_WEB_SERVER=false
      INSTALL_WEB_INTERFACE=false
      LIGHTTPD_ENABLED=false
      BLOCKING_ENABLED=true
      PIHOLE_DNS_1=127.0.0.1#5335
      PIHOLE_DNS_2=

  - path: /etc/pihole/pihole-FTL.conf
    owner: root:root
    permissions: '0644'
    content: |
      PRIVACYLEVEL=3
      DBFILE=
      LOCAL_IPV4=10.8.0.1

  - path: /usr/local/bin/init-wireguard.sh
    owner: root:root
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      set -euo pipefail

      WG_DIR="/etc/wireguard"
      CLIENTS_DIR="/home/${admin_username}/wireguard-clients"
      mkdir -p "$WG_DIR" "$CLIENTS_DIR"
      chmod 700 "$WG_DIR" "$CLIENTS_DIR"

      # Apply sysctl settings
      sysctl -p /etc/sysctl.d/99-wireguard.conf
      sysctl -p /etc/sysctl.d/99-security-hardening.conf

      # Detect default network interface
      DEFAULT_NIC=$(ip route show default 2>/dev/null | awk '/default/ {print $5}' | head -n1)
      if [ -z "$DEFAULT_NIC" ]; then
        DEFAULT_NIC="eth0"
      fi

      # Server endpoint resolution (domain name or public IP)
      SERVER_ENDPOINT="${server_domain_name}"
      if [ -z "$SERVER_ENDPOINT" ] || [ "$SERVER_ENDPOINT" = "null" ]; then
        SERVER_ENDPOINT="${server_public_ip}"
        if [ -z "$SERVER_ENDPOINT" ] || [ "$SERVER_ENDPOINT" = "null" ]; then
          SERVER_ENDPOINT=$(curl -s -4 ifconfig.me || curl -s -4 icanhazip.com || true)
        fi
      fi

      WG_PORT="${wireguard_port}"

      # Generate server keys
      if [ ! -f "$WG_DIR/server_private.key" ]; then
        umask 077
        wg genkey | tee "$WG_DIR/server_private.key" | wg pubkey > "$WG_DIR/server_public.key"
      fi

      SERVER_PRIV_KEY=$(cat "$WG_DIR/server_private.key")
      SERVER_PUB_KEY=$(cat "$WG_DIR/server_public.key")

      # Generate initial client (client1) keys
      if [ ! -f "$WG_DIR/client1_private.key" ]; then
        umask 077
        wg genkey | tee "$WG_DIR/client1_private.key" | wg pubkey > "$WG_DIR/client1_public.key"
      fi

      CLIENT1_PRIV_KEY=$(cat "$WG_DIR/client1_private.key")
      CLIENT1_PUB_KEY=$(cat "$WG_DIR/client1_public.key")

      if [ ! -f "$WG_DIR/client1_psk.key" ]; then
        umask 077
        wg genpsk > "$WG_DIR/client1_psk.key"
        chmod 600 "$WG_DIR/client1_psk.key"
      fi

      CLIENT1_PSK=$(cat "$WG_DIR/client1_psk.key")

      # Generate wg0.conf
      cat <<EOF > "$WG_DIR/wg0.conf"
      [Interface]
      Address = 10.8.0.1/24
      ListenPort = $WG_PORT
      PrivateKey = $SERVER_PRIV_KEY
      SaveConfig = false
      PostUp = iptables -t nat -A POSTROUTING -o $DEFAULT_NIC -j MASQUERADE; iptables -A FORWARD -i wg0 -j ACCEPT; iptables -A FORWARD -o wg0 -m state --state RELATED,ESTABLISHED -j ACCEPT
      PostDown = iptables -t nat -D POSTROUTING -o $DEFAULT_NIC -j MASQUERADE; iptables -D FORWARD -i wg0 -j ACCEPT; iptables -D FORWARD -o wg0 -m state --state RELATED,ESTABLISHED -j ACCEPT

      # Peer: client1
      [Peer]
      PublicKey = $CLIENT1_PUB_KEY
      AllowedIPs = 10.8.0.2/32
      PresharedKey = $CLIENT1_PSK
      EOF
      chmod 600 "$WG_DIR/wg0.conf"

      # Generate initial client1.conf
      cat <<EOF > "$WG_DIR/client1.conf"
      [Interface]
      PrivateKey = $CLIENT1_PRIV_KEY
      Address = 10.8.0.2/32
      DNS = 10.8.0.1

      [Peer]
      PublicKey = $SERVER_PUB_KEY
      Endpoint = $SERVER_ENDPOINT:$WG_PORT
      AllowedIPs = 0.0.0.0/0
      PersistentKeepalive = 25
      PresharedKey = $CLIENT1_PSK
      EOF
      chmod 600 "$WG_DIR/client1.conf"

      # Copy client configuration to admin user directory
      cp "$WG_DIR/client1.conf" "$CLIENTS_DIR/client1.conf"
      chown -R ${admin_username}:${admin_username} "$CLIENTS_DIR"
      chmod 600 "$CLIENTS_DIR/client1.conf"

      # Save endpoint info for helper scripts
      echo "$SERVER_ENDPOINT:$WG_PORT" > "$WG_DIR/endpoint.info"
      chmod 600 "$WG_DIR/endpoint.info"

      # Enable and start WireGuard systemd service
      systemctl daemon-reload
      systemctl enable wg-quick@wg0
      systemctl restart wg-quick@wg0

  - path: /usr/local/bin/add-wg-client
    owner: root:root
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      set -euo pipefail

      if [ "$#" -ne 1 ]; then
        echo "Usage: sudo $0 <client-name>"
        echo "Example: sudo $0 phone"
        exit 1
      fi

      CLIENT_NAME="$1"
      if [[ ! "$CLIENT_NAME" =~ ^[a-zA-Z0-9_-]+$ ]]; then
        echo "Error: Client name must contain only alphanumeric characters, underscores, and dashes."
        exit 1
      fi

      WG_DIR="/etc/wireguard"
      CLIENTS_DIR="/home/${admin_username}/wireguard-clients"
      mkdir -p "$CLIENTS_DIR"

      if [ "$EUID" -ne 0 ]; then
        echo "Error: This script must be run as root (e.g. using sudo)."
        exit 1
      fi

      if [ ! -f "$WG_DIR/wg0.conf" ] || [ ! -f "$WG_DIR/server_public.key" ]; then
        echo "Error: WireGuard server is not initialized."
        exit 1
      fi

      if [ -f "$WG_DIR/$CLIENT_NAME.conf" ] || [ -f "$CLIENTS_DIR/$CLIENT_NAME.conf" ] || grep -q "# Peer: $CLIENT_NAME\$" "$WG_DIR/wg0.conf"; then
        echo "Error: Client '$CLIENT_NAME' already exists."
        exit 1
      fi

      # Determine next IP octet
      USED_IPS=$(grep -oE '10\.8\.0\.[0-9]+' "$WG_DIR/wg0.conf" | awk -F. '{print $4}' | sort -n)
      NEXT_OCTET=2
      for octet in $USED_IPS; do
        if [ "$octet" -eq "$NEXT_OCTET" ]; then
          NEXT_OCTET=$((NEXT_OCTET + 1))
        fi
      done

      if [ "$NEXT_OCTET" -gt 254 ]; then
        echo "Error: Subnet address pool exhausted."
        exit 1
      fi

      CLIENT_IP="10.8.0.$NEXT_OCTET"
      SERVER_PUB_KEY=$(cat "$WG_DIR/server_public.key")

      if [ -f "$WG_DIR/endpoint.info" ]; then
        ENDPOINT=$(cat "$WG_DIR/endpoint.info")
      else
        ENDPOINT="$(curl -s -4 ifconfig.me):${wireguard_port}"
      fi

      CLIENT_PRIV_KEY=$(wg genkey)
      CLIENT_PUB_KEY=$(echo "$CLIENT_PRIV_KEY" | wg pubkey)
      umask 077
      wg genpsk > "$WG_DIR/$${CLIENT_NAME}_psk.key"
      chmod 600 "$WG_DIR/$${CLIENT_NAME}_psk.key"
      chown root:root "$WG_DIR/$${CLIENT_NAME}_psk.key"
      CLIENT_PSK=$(cat "$WG_DIR/$${CLIENT_NAME}_psk.key")

      # Add peer dynamically to the live interface
      wg set wg0 peer "$CLIENT_PUB_KEY" allowed-ips "$CLIENT_IP/32" preshared-key <(cat "$WG_DIR/$${CLIENT_NAME}_psk.key")

      # Append peer to persistent configuration
      cat <<EOF >> "$WG_DIR/wg0.conf"

      # Peer: $CLIENT_NAME
      [Peer]
      PublicKey = $CLIENT_PUB_KEY
      AllowedIPs = $CLIENT_IP/32
      PresharedKey = $CLIENT_PSK
      EOF

      # Write client configuration file
      CLIENT_CONF="$WG_DIR/$CLIENT_NAME.conf"
      cat <<EOF > "$CLIENT_CONF"
      [Interface]
      PrivateKey = $CLIENT_PRIV_KEY
      Address = $CLIENT_IP/32
      DNS = 10.8.0.1

      [Peer]
      PublicKey = $SERVER_PUB_KEY
      Endpoint = $ENDPOINT
      AllowedIPs = 0.0.0.0/0
      PersistentKeepalive = 25
      PresharedKey = $CLIENT_PSK
      EOF

      chmod 600 "$CLIENT_CONF"
      cp "$CLIENT_CONF" "$CLIENTS_DIR/$CLIENT_NAME.conf"
      chown ${admin_username}:${admin_username} "$CLIENTS_DIR/$CLIENT_NAME.conf"
      chmod 600 "$CLIENTS_DIR/$CLIENT_NAME.conf"

      echo "================================================================="
      echo " WireGuard client '$CLIENT_NAME' created successfully!"
      echo " Assigned IP: $CLIENT_IP"
      echo " Config file: $CLIENT_CONF"
      echo "================================================================="
      echo ""
      echo "Scan the QR code below using your WireGuard mobile app:"
      echo ""
      qrencode -t ansiutf8 < "$CLIENT_CONF"
      echo ""
      echo "Configuration file saved to: $CLIENT_CONF"

runcmd:
  # --- Sysctl apply ---
  - sysctl --system
  # --- Systemd-resolved: disable stub listener and apply DNS configuration ---
  - systemctl restart systemd-resolved
  # --- Unbound: download root hints and start service ---
  - curl -o /var/lib/unbound/root.hints https://www.internic.net/domain/named.root
  - systemctl enable unbound
  - systemctl restart unbound
  # --- Pi-hole: run unattended installer (setupVars.conf already written) ---
  - curl -sSL https://install.pi-hole.net | bash /dev/stdin --unattended
  # --- Pi-hole: restart pihole-FTL so pihole-FTL.conf no-log overrides take effect ---
  - systemctl restart pihole-FTL
  # --- Dnsdist: initialize temporary TLS certificates if missing so service starts cleanly ---
  - |
    if [ ! -f /etc/dnsdist/fullchain.pem ] || [ ! -f /etc/dnsdist/privkey.pem ]; then
      mkdir -p /etc/dnsdist
      openssl req -x509 -newkey rsa:2048 -keyout /etc/dnsdist/privkey.pem -out /etc/dnsdist/fullchain.pem -days 365 -nodes -subj '/CN=${server_domain_name}'
      chown _dnsdist:_dnsdist /etc/dnsdist/fullchain.pem /etc/dnsdist/privkey.pem
      chmod 644 /etc/dnsdist/fullchain.pem
      chmod 600 /etc/dnsdist/privkey.pem
    fi
  - systemctl enable dnsdist
  - systemctl restart dnsdist
  # --- WireGuard initialisation ---
  - [ /usr/local/bin/init-wireguard.sh ]
  # --- Firewall (UFW) configuration matching VM ---
  - ufw default deny incoming
  - ufw default allow outgoing
  - ufw default deny routed
  - ufw allow in on lo to any port 53
  - ufw allow in on wg0 to any port 53
  - ufw deny 53/tcp comment 'Block public plaintext DNS'
  - ufw deny 53/udp comment 'Block public plaintext DNS'
  - ufw deny in on eth0 to any port 80/tcp comment 'Block public HTTP on eth0'
  - ufw allow 22/tcp comment 'SSH'
  - ufw allow 853/tcp comment 'DNS-over-TLS'
  - ufw allow ${wireguard_port}/udp comment 'WireGuard VPN'
  - ufw allow in on lo comment 'Allow Loopback'
  - ufw allow in on wg0 comment 'Allow WireGuard interface'
  - ufw allow 443/tcp comment 'DNS-over-HTTPS'
  - ufw --force enable
  # --- Fail2ban initialisation ---
  - systemctl enable fail2ban
  - systemctl restart fail2ban
